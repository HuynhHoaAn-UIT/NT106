<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================= -->
    <!-- FONT FAMILIES                     -->
    <!-- ================================= -->

    <FontFamily x:Key="FontInter">
        pack://application:,,,/GlobalSuccess.Desktop;component/Assets/Fonts/#Inter
    </FontFamily>

    <FontFamily x:Key="FontInterItalic">
        pack://application:,,,/GlobalSuccess.Desktop;component/Assets/Fonts/#Inter
    </FontFamily>

    <FontFamily x:Key="FontSuezOne">
        pack://application:,,,/GlobalSuccess.Desktop;component/Assets/Fonts/#Suez One
    </FontFamily>

    <FontFamily x:Key="FontTiltWarp">
        pack://application:,,,/GlobalSuccess.Desktop;component/Assets/Fonts/#Tilt Warp
    </FontFamily>


    <!-- ================================= -->
    <!-- BRAND TYPOGRAPHY                  -->
    <!-- ================================= -->

    <Style x:Key="TextBrand"
           TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource FontSuezOne}"/>

        <Setter Property="FontSize" Value="26"/>

        <Setter Property="Foreground"
                Value="{StaticResource BrushPrimary}"/>

    </Style>


    <!-- ================================= -->
    <!-- DISPLAY TYPOGRAPHY                -->
    <!-- ================================= -->

    <Style x:Key="TextDisplay"
           TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource FontSuezOne}"/>

        <Setter Property="FontSize" Value="36"/>

        <Setter Property="Foreground"
                Value="{StaticResource BrushTextPrimary}"/>

    </Style>


    <!-- ================================= -->
    <!-- HEADINGS                          -->
    <!-- ================================= -->

    <Style x:Key="TextHeading1"
           TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource FontInter}"/>

        <Setter Property="FontSize" Value="28"/>

        <Setter Property="FontWeight" Value="Bold"/>

        <Setter Property="Foreground"
                Value="{StaticResource BrushTextPrimary}"/>

    </Style>


    <Style x:Key="TextHeading2"
           TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource FontInter}"/>

        <Setter Property="FontSize" Value="22"/>

        <Setter Property="FontWeight" Value="SemiBold"/>

        <Setter Property="Foreground"
                Value="{StaticResource BrushTextPrimary}"/>

    </Style>


    <Style x:Key="TextHeading3"
           TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource FontInter}"/>

        <Setter Property="FontSize" Value="18"/>

        <Setter Property="FontWeight" Value="SemiBold"/>

        <Setter Property="Foreground"
                Value="{StaticResource BrushTextPrimary}"/>

    </Style>


    <!-- ================================= -->
    <!-- BODY                              -->
    <!-- ================================= -->

    <Style x:Key="TextBody"
           TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource FontInter}"/>

        <Setter Property="FontSize" Value="14"/>

        <Setter Property="Foreground"
                Value="{StaticResource BrushTextPrimary}"/>

    </Style>


    <Style x:Key="TextBodyMedium"
           TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource FontInter}"/>

        <Setter Property="FontSize" Value="14"/>

        <Setter Property="FontWeight" Value="Medium"/>

        <Setter Property="Foreground"
                Value="{StaticResource BrushTextPrimary}"/>

    </Style>


    <!-- ================================= -->
    <!-- CAPTION                           -->
    <!-- ================================= -->

    <Style x:Key="TextCaption"
           TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource FontInter}"/>

        <Setter Property="FontSize" Value="12"/>

        <Setter Property="Foreground"
                Value="{StaticResource BrushTextHint}"/>

    </Style>


    <!-- ================================= -->
    <!-- ITALIC                            -->
    <!-- ================================= -->

    <Style x:Key="TextItalic"
           TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource FontInterItalic}"/>

        <Setter Property="FontSize" Value="14"/>

        <Setter Property="FontStyle" Value="Italic"/>

        <Setter Property="Foreground"
                Value="{StaticResource BrushTextSecondary}"/>

    </Style>


    <!-- ================================= -->
    <!-- CTA                               -->
    <!-- ================================= -->

    <Style x:Key="TextCTA"
           TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily"
                Value="{StaticResource FontTiltWarp}"/>

        <Setter Property="FontSize" Value="14"/>

        <Setter Property="Foreground" Value="White"/>

    </Style>

</ResourceDictionary>
