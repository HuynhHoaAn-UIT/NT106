<Window x:Class="GlobalSuccess.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GLOBAL SUCCESS - Design System Preview"
        Height="850"
        Width="1100"
        MinHeight="700"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="40">

            <!-- HEADER -->

            <TextBlock Text="GLOBAL SUCCESS"
                       Style="{StaticResource TextBrand}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Design System Preview"
                       Style="{StaticResource TextDisplay}"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Colors | Typography | Buttons"
                       Style="{StaticResource TextCaption}"
                       Margin="0,0,0,30"/>


            <!-- 01. COLORS -->

            <TextBlock Text="01. COLOR SYSTEM"
                       Style="{StaticResource TextHeading1}"
                       Margin="0,0,0,15"/>

            <Border Background="{StaticResource BrushPrimary}"
                    CornerRadius="10"
                    Padding="24"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="PRIMARY BRAND"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock Text="#0F0954"
                               Foreground="White"
                               FontSize="14"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>


            <UniformGrid Columns="3"
                         Margin="0,0,0,20">

                <Border Background="{StaticResource BrushBackground}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        Padding="18"
                        Margin="0,0,8,0">

                    <StackPanel>
                        <TextBlock Text="Background"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="#F8FAFC"
                                   Foreground="{StaticResource BrushTextHint}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                </Border>


                <Border Background="{StaticResource BrushSecondaryBackground}"
                        Padding="18"
                        Margin="4,0">

                    <StackPanel>
                        <TextBlock Text="Secondary"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="#E0ECFF"
                                   Foreground="{StaticResource BrushTextHint}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                </Border>


                <Border Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        Padding="18"
                        Margin="8,0,0,0">

                    <StackPanel>
                        <TextBlock Text="Surface"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="#FFFFFF"
                                   Foreground="{StaticResource BrushTextHint}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                </Border>

            </UniformGrid>


            <!-- TEXT COLORS -->

            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,35">

                <StackPanel>

                    <TextBlock Text="TEXT COLORS"
                               Style="{StaticResource TextHeading3}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Primary Text - #0F172A"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="16"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Hint Text - #64748B"
                               Foreground="{StaticResource BrushTextHint}"
                               FontSize="14"/>

                </StackPanel>

            </Border>


            <!-- 02. TYPOGRAPHY -->

            <TextBlock Text="02. TYPOGRAPHY SYSTEM"
                       Style="{StaticResource TextHeading1}"
                       Margin="0,0,0,15"/>

            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    Margin="0,0,0,35">

                <StackPanel>

                    <TextBlock Text="GLOBAL SUCCESS"
                               Style="{StaticResource TextBrand}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Welcome back!"
                               Style="{StaticResource TextDisplay}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Heading 1"
                               Style="{StaticResource TextHeading1}"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Heading 2"
                               Style="{StaticResource TextHeading2}"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Heading 3"
                               Style="{StaticResource TextHeading3}"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Body: Find your opportunities and build your future."
                               Style="{StaticResource TextBody}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Body Medium"
                               Style="{StaticResource TextBodyMedium}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Caption: Your journey starts here."
                               Style="{StaticResource TextCaption}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Italic: Discover new opportunities."
                               Style="{StaticResource TextItalic}"/>

                </StackPanel>

            </Border>


            <!-- 03. BUTTONS -->

            <TextBlock Text="03. BUTTON SYSTEM"
                       Style="{StaticResource TextHeading1}"
                       Margin="0,0,0,15"/>

            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24"
                    Margin="0,0,0,35">

                <StackPanel Width="320"
                            HorizontalAlignment="Left">

                    <TextBlock Text="PRIMARY BUTTON"
                               Style="{StaticResource TextCaption}"
                               Margin="0,0,0,10"/>

                    <Button Content="SIGN IN"
                            Style="{StaticResource ButtonPrimary}"
                            Margin="0,0,0,20"/>


                    <TextBlock Text="SECONDARY BUTTON"
                               Style="{StaticResource TextCaption}"
                               Margin="0,0,0,10"/>

                    <Button Content="CANCEL"
                            Style="{StaticResource ButtonSecondary}"
                            Margin="0,0,0,20"/>


                    <TextBlock Text="TEXT BUTTON"
                               Style="{StaticResource TextCaption}"
                               Margin="0,0,0,10"/>

                    <Button Content="Forgot Password?"
                            Style="{StaticResource ButtonText}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,20"/>


                    <TextBlock Text="DISABLED BUTTON"
                               Style="{StaticResource TextCaption}"
                               Margin="0,0,0,10"/>

                    <Button Content="CONTINUE"
                            Style="{StaticResource ButtonPrimary}"
                            IsEnabled="False"/>

                </StackPanel>

            </Border>


            <!-- FOOTER -->

            <TextBlock Text="GLOBAL SUCCESS | DESIGN SYSTEM"
                       Style="{StaticResource TextCaption}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,20"/>

        </StackPanel>

    </ScrollViewer>

</Window>
