<UserControl x:Class="GlobalSuccess.Desktop.Views.Authentication.PasswordResetSuccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             MinWidth="1000"
             MinHeight="700">

    <UserControl.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="BrandPrimary" Color="#211B70"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F7FC"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#64748B"/>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#211B70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#342D8A"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#17124F"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- TEXT BUTTON -->
        <Style x:Key="TextButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#211B70"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================== -->
        <!-- LEFT PANEL - GIỮ NGUYÊN NHƯ SIGN IN -->
        <!-- ====================================== -->

        <Grid Grid.Column="0"
              Background="{StaticResource BrandPrimary}">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="350"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- LOGO -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="47,0,0,0"
                        VerticalAlignment="Center">

                <Image Source="/Assets/Icons/logo.png"
                                 Width="40"
                                 Height="40"
                                 Stretch="Uniform"/>

                <TextBlock Text="GLOBAL&#10;SUCCESS"
                           FontFamily="Inter"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           LineHeight="17"/>

            </StackPanel>

            <!-- HERO CONTENT -->
            <StackPanel Grid.Row="1"
                        Margin="47,0,38,30"
                        VerticalAlignment="Center">

                <TextBlock Text="CÙNG BẠN VƯƠN XA"
                           FontFamily="Inter"
                           FontSize="11"
                           Foreground="#D6D5F0"
                           Margin="0,0,0,28"/>

                <TextBlock Text="Kết nối hôm nay.&#10;Thành công toàn cầu."
                           FontFamily="Suez One"
                           FontSize="40"
                           Foreground="White"
                           TextWrapping="Wrap"
                           LineHeight="54"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Khám phá học bổng và đồng hành cùng cộng đồng người hướng dẫn&#10;trên hành trình học tập của bạn."
                           FontFamily="Inter"
                           FontSize="15"
                           Foreground="#F0EFFB"
                           TextWrapping="Wrap"
                           LineHeight="23"/>

            </StackPanel>

            <!-- CAMPUS IMAGE -->
            <Border Grid.Row="2"
                    Margin="47,0,54,0"
                    CornerRadius="12"
                    Background="#D8E2F1"
                    ClipToBounds="True">

                <svgc:SvgViewbox Source="/Assets/Icons/campus.svg"
                                 Stretch="UniformToFill"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"/>

            </Border>

            <!-- FOOTER -->
            <TextBlock Grid.Row="3"
                       Text="GLOBAL SUCCESS - Cơ hội học tập, kết nối toàn cầu"
                       FontFamily="Inter"
                       FontSize="10"
                       Foreground="#E0E0F4"
                       VerticalAlignment="Center"
                       Margin="47,0,0,0"/>

        </Grid>

        <!-- ====================================== -->
        <!-- RIGHT PANEL - SUCCESS -->
        <!-- ====================================== -->

        <Grid Grid.Column="1"
              Background="{StaticResource PageBackground}">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP NAVIGATION -->
            <Grid Grid.Row="0"
                  Margin="80,0,80,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Khám phá học bổng"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Trung tâm hỗ trợ"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>

            </Grid>

            <!-- SUCCESS CONTENT -->
            <Border Grid.Row="1"
                    Width="586"
                    Margin="80,32,0,30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                <StackPanel>

                    <!-- STEP INDICATOR -->
                    <TextBlock Text="KHÔI PHỤC MẬT KHẨU · BƯỚC 4/4"
                               FontFamily="Inter"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#211B70"
                               Margin="0,0,0,17"/>

                    <!-- TITLE -->
                    <TextBlock Text="Đặt lại mật khẩu thành công"
                               FontFamily="Suez One"
                               FontSize="32"
                               Foreground="#111827"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- DESCRIPTION -->
                    <TextBlock Text="Mật khẩu của bạn đã được cập nhật. Bạn có thể đăng nhập lại để tiếp tục hành trình học tập cùng GLOBAL SUCCESS."
                               FontFamily="Inter"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Margin="0,0,0,25"/>

                    <!-- SUCCESS ICON -->
                    <Grid Width="64"
                          Height="64"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20">

                        <Ellipse Fill="#E6F4EF"/>

                        <TextBlock Text="✓"
                                   FontFamily="Inter"
                                   FontSize="30"
                                   FontWeight="Medium"
                                   Foreground="#16805D"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Grid>

                    <!-- ACCOUNT INFORMATION -->
                    <TextBlock Text="Tài khoản của bạn"
                               FontFamily="Inter"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Loisbecket@gmail.com"
                               FontFamily="Inter"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,29"/>

                    <!-- LOGIN BUTTON -->
                    <Button Content="Đăng nhập lại"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,0,28"/>

                    <!-- HELPER TEXT -->
                    <TextBlock Text="Hãy sử dụng mật khẩu mới trong lần đăng nhập tiếp theo."
                               FontFamily="Inter"
                               FontSize="12"
                               Foreground="{StaticResource SecondaryText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>
