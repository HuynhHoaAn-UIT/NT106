<UserControl x:Class="GlobalSuccess.Desktop.Views.Authentication.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             MinWidth="1000"
             MinHeight="700">

    <UserControl.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="BrandPrimary" Color="#211B70"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F7FC"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#64748B"/>
        <SolidColorBrush x:Key="InputBorder" Color="#E2E8F0"/>

        <!-- PASSWORD STYLE -->
        <Style x:Key="ResetPasswordBoxStyle"
               TargetType="{x:Type PasswordBox}">

            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#211B70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#342D8A"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#17124F"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- TEXT BUTTON -->
        <Style x:Key="TextButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#211B70"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

        <!-- FIELD LABEL -->
        <Style x:Key="FieldLabelStyle"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,7"/>

        </Style>

    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================== -->
        <!-- LEFT PANEL - GIỮ NGUYÊN NHƯ SIGN IN -->
        <!-- ====================================== -->

        <Grid Grid.Column="0"
              Background="{StaticResource BrandPrimary}">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="350"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- LOGO -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="47,0,0,0"
                        VerticalAlignment="Center">

                <svgc:SvgViewbox Source="/Assets/Images/logo.svg"
                                 Width="40"
                                 Height="40"
                                 Stretch="Uniform"/>

                <TextBlock Text="GLOBAL&#10;SUCCESS"
                           FontFamily="Inter"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           LineHeight="17"/>

            </StackPanel>

            <!-- HERO CONTENT -->
            <StackPanel Grid.Row="1"
                        Margin="47,0,38,30"
                        VerticalAlignment="Center">

                <TextBlock Text="CÙNG BẠN VƯƠN XA"
                           FontFamily="Inter"
                           FontSize="11"
                           Foreground="#D6D5F0"
                           Margin="0,0,0,28"/>

                <TextBlock Text="Kết nối hôm nay.&#10;Thành công toàn cầu."
                           FontFamily="Suez One"
                           FontSize="40"
                           Foreground="White"
                           TextWrapping="Wrap"
                           LineHeight="54"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Khám phá học bổng và đồng hành cùng cộng đồng người hướng dẫn&#10;trên hành trình học tập của bạn."
                           FontFamily="Inter"
                           FontSize="15"
                           Foreground="#F0EFFB"
                           TextWrapping="Wrap"
                           LineHeight="23"/>

            </StackPanel>

            <!-- CAMPUS IMAGE -->
            <Border Grid.Row="2"
                    Margin="47,0,54,0"
                    CornerRadius="12"
                    Background="#D8E2F1"
                    ClipToBounds="True">

                <svgc:SvgViewbox Source="/Assets/Images/campus.svg"
                                 Stretch="UniformToFill"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"/>

            </Border>

            <!-- FOOTER -->
            <TextBlock Grid.Row="3"
                       Text="GLOBAL SUCCESS - Cơ hội học tập, kết nối toàn cầu"
                       FontFamily="Inter"
                       FontSize="10"
                       Foreground="#E0E0F4"
                       VerticalAlignment="Center"
                       Margin="47,0,0,0"/>

        </Grid>

        <!-- ====================================== -->
        <!-- RIGHT PANEL - RESET PASSWORD -->
        <!-- ====================================== -->

        <Grid Grid.Column="1"
              Background="{StaticResource PageBackground}">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP NAVIGATION -->
            <Grid Grid.Row="0"
                  Margin="106,0,106,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Khám phá học bổng"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Trung tâm hỗ trợ"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>

            </Grid>

            <!-- RESET PASSWORD FORM -->
            <Border Grid.Row="1"
                    Width="586"
                    Margin="106,32,0,20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                <StackPanel>

                    <!-- STEP INDICATOR -->
                    <TextBlock Text="KHÔI PHỤC MẬT KHẨU · BƯỚC 3/4"
                               FontFamily="Inter"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#211B70"
                               Margin="0,0,0,17"/>

                    <!-- TITLE -->
                    <TextBlock Text="Đặt mật khẩu mới"
                               FontFamily="Suez One"
                               FontSize="32"
                               Foreground="#111827"
                               Margin="0,0,0,12"/>

                    <!-- DESCRIPTION -->
                    <TextBlock Text="Tạo mật khẩu mới cho tài khoản Loisbecket@gmail.com. Mật khẩu mới cần khác mật khẩu cũ."
                               FontFamily="Inter"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Margin="0,0,0,29"/>

                    <!-- NEW PASSWORD LABEL -->
                    <TextBlock Text="Mật khẩu mới"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <!-- NEW PASSWORD INPUT -->
                    <Grid Height="46"
                          Margin="0,0,0,22">

                        <Border Background="White"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="8"/>

                        <PasswordBox x:Name="NewPasswordBox"
                                     Style="{StaticResource ResetPasswordBoxStyle}"
                                     Margin="0,0,42,0"/>

                        <!-- EYE ICON PLACEHOLDER -->
                        <TextBlock Text="◉"
                                   FontSize="16"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>

                    </Grid>

                    <!-- PASSWORD REQUIREMENTS -->
                    <StackPanel Margin="0,0,0,26">

                        <TextBlock Text="Mật khẩu của bạn cần có:"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">

                            <TextBlock Text="✓"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Ít nhất 8 ký tự"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryText}"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,8">

                            <TextBlock Text="✓"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Ít nhất 1 chữ hoa và 1 chữ thường"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryText}"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="✓"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="Ít nhất 1 chữ số và 1 ký tự đặc biệt (ví dụ: @, #, !)"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryText}"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- CONFIRM PASSWORD LABEL -->
                    <TextBlock Text="Xác nhận mật khẩu mới"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <!-- CONFIRM PASSWORD INPUT -->
                    <Grid Height="46"
                          Margin="0,0,0,25">

                        <Border Background="White"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="8"/>

                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Style="{StaticResource ResetPasswordBoxStyle}"
                                     Margin="0,0,42,0"/>

                        <!-- EYE ICON PLACEHOLDER -->
                        <TextBlock Text="◉"
                                   FontSize="16"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>

                    </Grid>

                    <!-- RESET PASSWORD BUTTON -->
                    <Button Content="Đặt lại mật khẩu"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,0,28"/>

                    <!-- BACK TO SIGN IN -->
                    <Button Content="← Quay lại đăng nhập"
                            Style="{StaticResource TextButtonStyle}"
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>
