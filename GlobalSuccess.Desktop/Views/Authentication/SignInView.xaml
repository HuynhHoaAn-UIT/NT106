<UserControl x:Class="GlobalSuccess.Desktop.Views.Authentication.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="1024"
             MinWidth="1000"
             MinHeight="700">

    <UserControl.Resources>

        <!-- ===================================== -->
        <!-- COLORS -->
        <!-- ===================================== -->

        <SolidColorBrush x:Key="BrandPrimary" Color="#211B70"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F7FC"/>
        <SolidColorBrush x:Key="MainText" Color="#0F172A"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#64748B"/>
        <SolidColorBrush x:Key="InputBorder" Color="#E2E8F0"/>


        <!-- ===================================== -->
        <!-- EMAIL INPUT -->
        <!-- ===================================== -->

        <Style x:Key="SignInTextBoxStyle"
               TargetType="{x:Type TextBox}">

            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">

                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#211B70"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <!-- ===================================== -->
        <!-- PASSWORD INPUT -->
        <!-- ===================================== -->

        <Style x:Key="SignInPasswordBoxStyle"
               TargetType="{x:Type PasswordBox}">

            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">

                        <Border Background="{TemplateBinding Background}">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <!-- ===================================== -->
        <!-- PRIMARY BUTTON -->
        <!-- ===================================== -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#211B70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#342D8A"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#17124F"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>


        <!-- ===================================== -->
        <!-- TEXT BUTTON -->
        <!-- ===================================== -->

        <Style x:Key="TextButtonStyle"
               TargetType="{x:Type Button}">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#211B70"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>


    <!-- ========================================= -->
    <!-- MAIN LAYOUT -->
    <!-- ========================================= -->

    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>


        <!-- ===================================== -->
        <!-- LEFT PANEL -->
        <!-- ===================================== -->

        <Grid Grid.Column="0"
              Background="{StaticResource BrandPrimary}">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="350"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>


            <!-- LOGO -->

            <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            Margin="47,0,0,0"
            VerticalAlignment="Center">

                <Image Source="/Assets/Icons/logo.png"
                     Width="40"
                     Height="40"
                     Stretch="Uniform"/>

                <TextBlock Text="GLOBAL&#10;SUCCESS"
               FontFamily="Inter"
               FontSize="14"
               FontWeight="Bold"
               Foreground="White"
               Margin="11,0,0,0"
               VerticalAlignment="Center"
               LineHeight="17"/>

            </StackPanel>


            <!-- HERO CONTENT -->

            <StackPanel Grid.Row="1"
                        Margin="47,0,38,30"
                        VerticalAlignment="Center">

                <TextBlock Text="CÙNG BẠN VƯƠN XA"
                           FontFamily="Inter"
                           FontSize="11"
                           Foreground="#D6D5F0"
                           Margin="0,0,0,28"/>

                <TextBlock Text="Kết nối hôm nay.&#10;Thành công toàn cầu."
                           FontFamily="Suez One"
                           FontSize="40"
                           Foreground="White"
                           TextWrapping="Wrap"
                           LineHeight="54"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Khám phá học bổng và đồng hành cùng cộng đồng người hướng dẫn&#10;trên hành trình học tập của bạn."
                           FontFamily="Inter"
                           FontSize="15"
                           Foreground="#F0EFFB"
                           TextWrapping="Wrap"
                           LineHeight="23"/>

            </StackPanel>


            <!-- CAMPUS IMAGE -->

            <Border Grid.Row="2"
        Margin="47,0,54,0"
        CornerRadius="12"
        Background="#D8E2F1"
        ClipToBounds="True">

                <svgc:SvgViewbox Source="/Assets/Icons/campus.svg"
                     Stretch="UniformToFill"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"/>

            </Border>


            <!-- FOOTER -->

            <TextBlock Grid.Row="3"
                       Text="GLOBAL SUCCESS - Cơ hội học tập, kết nối toàn cầu"
                       FontFamily="Inter"
                       FontSize="10"
                       Foreground="#E0E0F4"
                       VerticalAlignment="Center"
                       Margin="47,0,0,0"/>

        </Grid>


        <!-- ===================================== -->
        <!-- RIGHT PANEL -->
        <!-- ===================================== -->

        <Grid Grid.Column="1"
              Background="{StaticResource PageBackground}">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- TOP NAVIGATION -->

            <Grid Grid.Row="0"
                  Margin="106,0,106,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Khám phá học bổng"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Trung tâm hỗ trợ"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>

            </Grid>


            <!-- SIGN IN FORM -->

            <Border Grid.Row="1"
                    Width="586"
                    Margin="106,120,0,30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                <StackPanel>

                    <!-- TITLE -->

                    <TextBlock Text="Đăng nhập tài khoản"
                               FontFamily="Suez One"
                               FontSize="32"
                               Foreground="#111827"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="Nhập email và mật khẩu để đăng nhập"
                               FontFamily="Inter"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,0,0,39"/>


                    <!-- EMAIL -->

                    <TextBlock Text="Email"
                               FontFamily="Inter"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="txtEmail"
                             Style="{StaticResource SignInTextBoxStyle}"
                             Margin="0,0,0,32"/>


                    <!-- PASSWORD -->

                    <TextBlock Text="Mật khẩu"
                               FontFamily="Inter"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,0,0,7"/>

                    <Grid Height="46"
                          Margin="0,0,0,10">

                        <Border Background="White"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="8"/>

                        <PasswordBox x:Name="txtPassword"
                                     Style="{StaticResource SignInPasswordBoxStyle}"
                                     Margin="0,0,42,0"/>

                        <TextBox x:Name="txtPasswordVisible"
                                 Height="46"
                                 Padding="14,0"
                                 FontFamily="Inter"
                                 FontSize="13"
                                 Foreground="#0F172A"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,42,0"
                                 Visibility="Collapsed"/>

                        <!-- Eye icon toggle -->
                        <TextBlock x:Name="iconTogglePassword"
                                   Text="&#128065;"
                                   FontSize="16"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"
                                   Cursor="Hand"
                                   MouseLeftButtonDown="IconTogglePassword_MouseLeftButtonDown"/>

                    </Grid>


                    <!-- FORGOT PASSWORD -->

                    <Button Content="Quên mật khẩu?"
                            Style="{StaticResource TextButtonStyle}"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,31"
                            Click="BtnForgotPassword_Click"/>


                    <!-- SIGN IN BUTTON -->

                    <Button Content="Đăng nhập"
                            Style="{StaticResource PrimaryButtonStyle}" Click="BtnSignIn_Click"/>


                    <!-- REGISTER LINK -->

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,28,0,0">

                        <TextBlock Text="Bạn chưa có tài khoản?"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center"/>

                        <Button Content="Đăng ký"
                                Style="{StaticResource TextButtonStyle}"
                                FontWeight="Bold"
                                FontSize="12"
                                Padding="7,0,0,0"
                                Click="BtnGoToSignUp_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>
