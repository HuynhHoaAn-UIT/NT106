<UserControl x:Class="GlobalSuccess.Desktop.Views.Authentication.SignUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             MinWidth="1000"
             MinHeight="700">

    <UserControl.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="BrandPrimary" Color="#211B70"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F7FC"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#64748B"/>
        <SolidColorBrush x:Key="InputBorder" Color="#E2E8F0"/>

        <!-- INPUT STYLE -->
        <Style x:Key="SignUpTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#211B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PASSWORD STYLE -->
        <Style x:Key="SignUpPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#211B70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#342D8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#17124F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXT BUTTON -->
        <Style x:Key="TextButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#211B70"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FIELD LABEL -->
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================== -->
        <!-- LEFT PANEL - GIỮ NGUYÊN NHƯ SIGN IN -->
        <!-- ====================================== -->

        <Grid Grid.Column="0"
              Background="{StaticResource BrandPrimary}">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="350"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- LOGO -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="47,0,0,0"
                        VerticalAlignment="Center">

                <svgc:SvgViewbox Source="/Assets/Images/logo.svg"
                                 Width="40"
                                 Height="40"
                                 Stretch="Uniform"/>

                <TextBlock Text="GLOBAL&#10;SUCCESS"
                           FontFamily="Inter"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="11,0,0,0"
                           VerticalAlignment="Center"
                           LineHeight="17"/>
            </StackPanel>

            <!-- HERO CONTENT -->
            <StackPanel Grid.Row="1"
                        Margin="47,0,38,30"
                        VerticalAlignment="Center">

                <TextBlock Text="CÙNG BẠN VƯƠN XA"
                           FontFamily="Inter"
                           FontSize="11"
                           Foreground="#D6D5F0"
                           Margin="0,0,0,28"/>

                <TextBlock Text="Kết nối hôm nay.&#10;Thành công toàn cầu."
                           FontFamily="Suez One"
                           FontSize="40"
                           Foreground="White"
                           TextWrapping="Wrap"
                           LineHeight="54"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Khám phá học bổng và đồng hành cùng cộng đồng người hướng dẫn&#10;trên hành trình học tập của bạn."
                           FontFamily="Inter"
                           FontSize="15"
                           Foreground="#F0EFFB"
                           TextWrapping="Wrap"
                           LineHeight="23"/>
            </StackPanel>

            <!-- CAMPUS IMAGE -->
            <Border Grid.Row="2"
                    Margin="47,0,54,0"
                    CornerRadius="12"
                    Background="#D8E2F1"
                    ClipToBounds="True">

                <svgc:SvgViewbox Source="/Assets/Images/campus.svg"
                                 Stretch="UniformToFill"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"/>
            </Border>

            <!-- FOOTER -->
            <TextBlock Grid.Row="3"
                       Text="GLOBAL SUCCESS - Cơ hội học tập, kết nối toàn cầu"
                       FontFamily="Inter"
                       FontSize="10"
                       Foreground="#E0E0F4"
                       VerticalAlignment="Center"
                       Margin="47,0,0,0"/>
        </Grid>

        <!-- ====================================== -->
        <!-- RIGHT PANEL - SIGN UP -->
        <!-- ====================================== -->

        <Grid Grid.Column="1"
              Background="{StaticResource PageBackground}">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP NAVIGATION -->
            <Grid Grid.Row="0"
                  Margin="106,0,106,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Khám phá học bổng"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Trung tâm hỗ trợ"
                        Style="{StaticResource TextButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- SIGN UP FORM -->
            <Border Grid.Row="1"
                    Width="586"
                    Margin="106,12,0,20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                <StackPanel>

                    <!-- TITLE -->
                    <TextBlock Text="Đăng ký"
                               FontFamily="Suez One"
                               FontSize="32"
                               Foreground="#111827"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Tạo tài khoản để tiếp tục!"
                               FontFamily="Inter"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,0,0,27"/>

                    <!-- FULL NAME -->
                    <TextBlock Text="Họ và tên"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource SignUpTextBoxStyle}"
                             Text="Lois Becket"
                             Margin="0,0,0,26"/>

                    <!-- EMAIL -->
                    <TextBlock Text="Email"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Style="{StaticResource SignUpTextBoxStyle}"
                             Text="Loisbecket@gmail.com"
                             Margin="0,0,0,26"/>

                    <!-- DATE OF BIRTH -->
                    <TextBlock Text="Ngày sinh"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <Grid Height="46" Margin="0,0,0,26">

                        <TextBox Style="{StaticResource SignUpTextBoxStyle}"
                                 Text="18/03/2024"
                                 Padding="14,0,42,0"/>

                        <TextBlock Text="▦"
                                   FontSize="17"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>
                    </Grid>

                    <!-- PHONE NUMBER -->
                    <TextBlock Text="Số điện thoại"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <Border Height="46"
                            Background="White"
                            BorderBrush="{StaticResource InputBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,26">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- COUNTRY CODE -->
                            <ComboBox Grid.Column="0"
                                      SelectedIndex="0"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      FontFamily="Inter"
                                      FontSize="12"
                                      VerticalContentAlignment="Center"
                                      Margin="8,0,0,0">

                                <ComboBoxItem Content="🇻🇳  +84"/>
                                <ComboBoxItem Content="🇺🇸  +1"/>
                                <ComboBoxItem Content="🇯🇵  +81"/>
                                <ComboBoxItem Content="🇨🇦  +1"/>
                            </ComboBox>

                            <Border Grid.Column="0"
                                    Width="1"
                                    Background="#E2E8F0"
                                    HorizontalAlignment="Right"
                                    Margin="0,9,0,9"/>

                            <!-- PHONE INPUT -->
                            <TextBox Grid.Column="1"
                                     Text="(454) 726-0592"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Inter"
                                     FontSize="13"
                                     Foreground="#0F172A"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0"/>
                        </Grid>
                    </Border>

                    <!-- PASSWORD -->
                    <TextBlock Text="Đặt mật khẩu"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <Grid Height="46" Margin="0,0,0,24">

                        <Border Background="White"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="8"/>

                        <PasswordBox Style="{StaticResource SignUpPasswordBoxStyle}"
                                     Margin="0,0,42,0"/>

                        <TextBlock Text="◉"
                                   FontSize="16"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>
                    </Grid>

                    <!-- SIGN UP BUTTON -->
                    <Button Content="Đăng ký"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,0,25"/>

                    <!-- LOGIN LINK -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Bạn đã có tài khoản?"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   Foreground="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center"/>

                        <Button Content="Đăng nhập"
                                Style="{StaticResource TextButtonStyle}"
                                FontWeight="Bold"
                                FontSize="12"
                                Padding="7,0,0,0"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
