<UserControl x:Class="GlobalSuccess.Desktop.Views.SavedItems.SavedItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             MinWidth="1000"
             MinHeight="700">

    <UserControl.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="BrandPrimary" Color="#211B70"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F7FC"/>
        <SolidColorBrush x:Key="MainText" Color="#0F172A"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

        <!-- SIDEBAR BUTTON -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#F1F0FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SEARCH TEXTBOX -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- OUTLINE BUTTON -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#211B70"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="8,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#211B70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#342D8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TAB BUTTON -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#EEEDFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SAVED SCHOLARSHIP CARD -->
        <Style x:Key="SavedCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </UserControl.Resources>

    <!-- ROOT -->
    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- SIDEBAR - SAME SHARED NAVIGATION -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">

                    <Image Source="/Assets/Icons/logo.png"
                           Width="40"
                           Height="40"
                           Stretch="Uniform"/>

                    <TextBlock Text="GLOBAL&#10;SUCCESS"
                               FontFamily="Inter"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#211B70"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               LineHeight="16"/>
                </StackPanel>

                <!-- MAIN NAVIGATION -->
                <StackPanel Grid.Row="1"
                            Margin="10,0,10,10">

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/compass.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Khám phá học bổng"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/Cộng đồng.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Cộng đồng"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/Tin nhắn.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Tin nhắn"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/Tài khoản.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Tài khoản"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- PERSONAL SPACE -->
                <StackPanel Grid.Row="2"
                            Margin="10,0,10,10">

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,0,0,18"/>

                    <TextBlock Text="KHÔNG GIAN CỦA BẠN"
                               FontFamily="Inter"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="10,0,0,8"/>

                    <!-- SAVED ITEMS ACTIVE -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Background="#EEEDFA"
                            Foreground="#211B70">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/bookmark.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Mục đã lưu"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- BOTTOM NAVIGATION -->
                <StackPanel Grid.Row="4"
                            Margin="10,0,10,10">

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/Đăng xuất.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Đăng xuất"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/Cài đặt.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Cài đặt tài khoản"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/circle-help.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Trung tâm hỗ trợ"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,8,0,12"/>

                    <!-- USER PROFILE -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="34"
                                 Height="34"
                                 Fill="#D8E2F1"
                                 VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="0"
                                   Text="KL"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#211B70"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="Nguyễn Kim Loan"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="Người hướng dẫn"
                                       FontFamily="Inter"
                                       FontSize="9"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="⌄"
                                   FontSize="15"
                                   Foreground="#211B70"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- MAIN AREA -->
        <!-- ================================================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">

                <Grid Margin="28,0,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <!-- BREADCRUMB -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="GLOBAL SUCCESS"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#94A3B8"/>

                        <TextBlock Text="  /  "
                                   FontSize="11"
                                   Foreground="#CBD5E1"/>

                        <TextBlock Text="Mục đã lưu"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                    </StackPanel>

                    <!-- SEARCH -->
                    <Border Grid.Column="1"
                            Width="260"
                            Height="38"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Center">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <svgc:SvgViewbox
                                Grid.Column="0"
                                Source="/Assets/Icons/Biểu tượng tìm kiếm.svg"
                                Width="15" Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="Tìm học bổng, bài viết..."/>
                        </Grid>
                    </Border>

                    <!-- NOTIFICATION -->
                    <svgc:SvgViewbox
                        Grid.Column="2"
                        Source="/Assets/Icons/Thông báo.svg"
                        Width="20" Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <!-- AVATAR -->
                    <Ellipse Grid.Column="3"
                             Width="30"
                             Height="30"
                             Fill="#D8E2F1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ================================================= -->
            <!-- SAVED ITEMS CONTENT -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="32,20,32,26">

                    <!-- PAGE HEADER -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Mục đã lưu"
                                       FontFamily="Suez One"
                                       FontSize="26"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="Học bổng và bài viết bạn muốn quay lại"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       Foreground="#94A3B8"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Khám phá học bổng"
                                Style="{StaticResource OutlineButtonStyle}"
                                Width="120"
                                Height="32"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- TABS -->
                    <WrapPanel Margin="0,0,0,12">

                        <Button Content="Học bổng đã theo dõi"
                                Background="#211B70"
                                Foreground="White"
                                Style="{StaticResource TabButtonStyle}"
                                Margin="0,0,6,0"/>

                        <Button Content="Bài viết đã đánh dấu"
                                Style="{StaticResource TabButtonStyle}"/>
                    </WrapPanel>

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,0,0,12"/>

                    <!-- SEARCH BAR -->
                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="38"
                            Margin="0,0,0,12">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <svgc:SvgViewbox
                                Grid.Column="0"
                                Source="/Assets/Icons/Biểu tượng tìm kiếm.svg"
                                Width="15" Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="Tìm kiếm học bổng hoặc bài viết..."/>
                        </Grid>
                    </Border>

                    <!-- MAIN TWO-COLUMN CONTENT -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.55*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: SAVED SCHOLARSHIPS -->
                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">

                            <!-- SCHOLARSHIP 1 -->
                            <Border Style="{StaticResource SavedCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ICON -->
                                        <Border Width="36"
                                                Height="36"
                                                Background="#EEEDFA"
                                                CornerRadius="8"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="♧"
                                                       FontSize="19"
                                                       Foreground="#211B70"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- DETAILS -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,8,0">

                                            <TextBlock Text="Học bổng Toàn phần Rhodes tại Oxford"
                                                       FontFamily="Suez One"
                                                       FontSize="13"
                                                       Foreground="#0F172A"
                                                       TextWrapping="Wrap"/>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,6,0,0">

                                                <TextBlock Text="◎"
                                                           FontSize="12"
                                                           Foreground="#211B70"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Text="  Anh Quốc"
                                                           FontFamily="Inter"
                                                           FontSize="9"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- DEADLINE AND ACTION -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center">

                                            <Border Background="#FFF0F0"
                                                    CornerRadius="10"
                                                    Padding="7,3"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,0,5">

                                                <TextBlock Text="Còn 12 ngày"
                                                           FontFamily="Inter"
                                                           FontSize="8"
                                                           FontWeight="SemiBold"
                                                           Foreground="#DC2626"/>
                                            </Border>

                                            <Button Content="Bỏ theo dõi"
                                                    Style="{StaticResource OutlineButtonStyle}"
                                                    Width="76"
                                                    Height="28"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- DIVIDER -->
                                    <Border Grid.Row="1"
                                            Background="#E2E8F0"
                                            Margin="0,9,0,8"/>

                                    <!-- FOOTER -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Đã theo dõi · Nhận cập nhật về học bổng này"
                                                   FontFamily="Inter"
                                                   FontSize="8"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="Xem chi tiết →"
                                                   FontFamily="Inter"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#211B70"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- SCHOLARSHIP 2 -->
                            <Border Style="{StaticResource SavedCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- ICON -->
                                        <Border Width="36"
                                                Height="36"
                                                Background="#EEEDFA"
                                                CornerRadius="8"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="♧"
                                                       FontSize="19"
                                                       Foreground="#211B70"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- DETAILS -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,8,0">

                                            <TextBlock Text="Học bổng Thạc sĩ Fulbright Việt Nam"
                                                       FontFamily="Suez One"
                                                       FontSize="13"
                                                       Foreground="#0F172A"
                                                       TextWrapping="Wrap"/>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,6,0,0">

                                                <TextBlock Text="◎"
                                                           FontSize="12"
                                                           Foreground="#211B70"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Text="  Hoa Kỳ"
                                                           FontFamily="Inter"
                                                           FontSize="9"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- DEADLINE AND ACTION -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center">

                                            <Border Background="#FFF0F0"
                                                    CornerRadius="10"
                                                    Padding="7,3"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,0,5">

                                                <TextBlock Text="Còn 45 ngày"
                                                           FontFamily="Inter"
                                                           FontSize="8"
                                                           FontWeight="SemiBold"
                                                           Foreground="#DC2626"/>
                                            </Border>

                                            <Button Content="Bỏ theo dõi"
                                                    Style="{StaticResource OutlineButtonStyle}"
                                                    Width="76"
                                                    Height="28"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- DIVIDER -->
                                    <Border Grid.Row="1"
                                            Background="#E2E8F0"
                                            Margin="0,9,0,8"/>

                                    <!-- FOOTER -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Đã theo dõi · Nhận cập nhật về học bổng này"
                                                   FontFamily="Inter"
                                                   FontSize="8"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="Xem chi tiết →"
                                                   FontFamily="Inter"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#211B70"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- RIGHT: INFORMATION CARDS -->
                        <StackPanel Grid.Column="1">

                            <!-- OPPORTUNITY REMINDER -->
                            <Border Background="#EEEDFA"
                                    BorderBrush="#E5E2F7"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    Padding="14"
                                    Margin="0,0,0,12">

                                <StackPanel>

                                    <TextBlock Text="Không bỏ lỡ cơ hội"
                                               FontFamily="Suez One"
                                               FontSize="15"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,8"/>

                                    <svgc:SvgViewbox
                                        Source="/Assets/Icons/bookmark.svg"
                                        Width="17"
                                        Height="17"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8"/>

                                    <TextBlock
