    <UserControl x:Class="GlobalSuccess.Desktop.Views.Account.AccountView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
                 Loaded="UserControl_Loaded"
                 MinWidth="1000"
                 MinHeight="700">

        <UserControl.Resources>

            <!-- COLORS -->
            <SolidColorBrush x:Key="BrandPrimary" Color="#211B70"/>
            <SolidColorBrush x:Key="PageBackground" Color="#F4F7FC"/>
            <SolidColorBrush x:Key="MainText" Color="#0F172A"/>
            <SolidColorBrush x:Key="SecondaryText" Color="#64748B"/>
            <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

            <!-- SIDEBAR BUTTON -->
            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="46"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="FontFamily" Value="Inter"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NavBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="10,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NavBorder"
                                            Property="Background"
                                            Value="#F1F0FA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- TOPBAR SEARCH -->
            <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="FontFamily" Value="Inter"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="#64748B"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <!-- PRIMARY BUTTON -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Background" Value="#211B70"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontFamily" Value="Inter"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="10,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#342D8A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#17124F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- OUTLINE BUTTON -->
            <Style x:Key="OutlineButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#211B70"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="Inter"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="10,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- UTILITY ITEM BUTTON -->
            <Style x:Key="UtilityItemButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#0F172A"/>
                <Setter Property="FontFamily" Value="Inter"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="3,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="#F4F3FB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </UserControl.Resources>

        <!-- ROOT -->
        <Grid Background="{StaticResource PageBackground}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!-- SIDEBAR -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,1,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- LOGO -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">

                        <Image Source="/Assets/Icons/logo.png"
                               Width="40"
                               Height="40"
                               Stretch="Uniform"/>

                        <TextBlock Text="GLOBAL&#10;SUCCESS"
                                   FontFamily="Inter"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#211B70"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   LineHeight="16"/>
                    </StackPanel>

                    <!-- MAIN NAVIGATION -->
                    <StackPanel Grid.Row="1"
                                Margin="10,0,10,10">

                        <Button Style="{StaticResource SidebarButtonStyle}" Click="BtnHome_Click">
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox
                                    Source="/Assets/Icons/compass.svg"
                                    Width="17" Height="17"
                                    Margin="0,0,12,0"/>
                                <TextBlock Text="Khám phá học bổng"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox
                                    Source="/Assets/Icons/Cộng đồng.svg"
                                    Width="17" Height="17"
                                    Margin="0,0,12,0"/>
                                <TextBlock Text="Cộng đồng"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox
                                    Source="/Assets/Icons/Tin nhắn.svg"
                                    Width="17" Height="17"
                                    Margin="0,0,12,0"/>
                                <TextBlock Text="Tin nhắn"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- ACCOUNT ACTIVE -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Background="#EEEDFA"
                                Foreground="#211B70">
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox
                                    Source="/Assets/Icons/Tài khoản.svg"
                                    Width="17" Height="17"
                                    Margin="0,0,12,0"/>
                                <TextBlock Text="Tài khoản"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- PERSONAL SPACE -->
                    <StackPanel Grid.Row="2"
                                Margin="10,0,10,10">

                        <Border Height="1"
                                Background="#E2E8F0"
                                Margin="0,0,0,18"/>

                        <TextBlock Text="KHÔNG GIAN CỦA BẠN"
                                   FontFamily="Inter"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#64748B"
                                   Margin="10,0,0,8"/>

                        <Button Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox
                                    Source="/Assets/Icons/bookmark.svg"
                                    Width="17" Height="17"
                                    Margin="0,0,12,0"/>
                                <TextBlock Text="Mục đã lưu"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- BOTTOM NAVIGATION -->
                    <StackPanel Grid.Row="4"
                                Margin="10,0,10,10">

                        <Button Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox
                                    Source="/Assets/Icons/Đăng xuất.svg"
                                    Width="17" Height="17"
                                    Margin="0,0,12,0"/>
                                <TextBlock Text="Đăng xuất"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox
                                    Source="/Assets/Icons/Cài đặt.svg"
                                    Width="17" Height="17"
                                    Margin="0,0,12,0"/>
                                <TextBlock Text="Cài đặt tài khoản"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SidebarButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <svgc:SvgViewbox
                                    Source="/Assets/Icons/circle-help.svg"
                                    Width="17" Height="17"
                                    Margin="0,0,12,0"/>
                                <TextBlock Text="Trung tâm hỗ trợ"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1"
                                Background="#E2E8F0"
                                Margin="0,8,0,12"/>

                        <!-- USER PROFILE -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Ellipse Width="34"
                                         Height="34"
                                         Fill="#D8E2F1"
                                         VerticalAlignment="Center"/>

                                <TextBlock x:Name="txtSidebarAvatar"
                                           Text="KL"
                                           FontFamily="Inter"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#211B70"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Ellipse Width="34"
                                         Height="34"
                                         VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="imgSidebarAvatar" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <TextBlock x:Name="txtSidebarFullName"
                                           Text="Nguyễn Kim Loan"
                                           FontFamily="Inter"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#0F172A"/>

                                <TextBlock Text="Người hướng dẫn"
                                           FontFamily="Inter"
                                           FontSize="9"
                                           Foreground="#64748B"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="⌄"
                                       FontSize="15"
                                       Foreground="#211B70"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================= -->
            <!-- MAIN AREA -->
            <!-- ================================================= -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOPBAR -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="28,0,28,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- BREADCRUMB -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="GLOBAL SUCCESS"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       Foreground="#94A3B8"/>

                            <TextBlock Text="  /  "
                                       FontSize="11"
                                       Foreground="#CBD5E1"/>

                            <TextBlock Text="Tài khoản"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       Foreground="#64748B"/>
                        </StackPanel>

                        <!-- SEARCH -->
                        <Border Grid.Column="1"
                                Width="260"
                                Height="38"
                                Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8"
                                VerticalAlignment="Center">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <svgc:SvgViewbox
                                    Grid.Column="0"
                                    Source="/Assets/Icons/Biểu tượng tìm kiếm.svg"
                                    Width="15" Height="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                <TextBox Grid.Column="1"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         Text="Tìm học bổng, bài viết..."/>
                            </Grid>
                        </Border>

                        <!-- NOTIFICATION -->
                        <svgc:SvgViewbox
                            Grid.Column="2"
                            Source="/Assets/Icons/Thông báo.svg"
                            Width="20" Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        <!-- TOPBAR AVATAR -->
                        <Grid Grid.Column="3"
                              Width="30"
                              Height="30"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Ellipse Width="30"
                                     Height="30"
                                     Fill="#D8E2F1"/>
                            <TextBlock x:Name="txtTopbarAvatar"
                                       Text="KL"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#211B70"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Ellipse Width="30"
                                     Height="30">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="imgTopbarAvatar" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ================================================= -->
                <!-- ACCOUNT CONTENT -->
                <!-- ================================================= -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="32,22,32,30">

                        <!-- PAGE HEADER -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Tài khoản"
                                           FontFamily="Suez One"
                                           FontSize="28"
                                           Foreground="#0F172A"/>

                                <TextBlock Text="Không gian cá nhân của bạn"
                                           FontFamily="Inter"
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Xem hồ sơ cá nhân"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Width="145"
                                    Height="38"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- PROFILE CARD -->
                        <Border Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,0,20">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- AVATAR -->
                                <Grid Grid.Column="0">
                                    <Ellipse Width="46"
                                             Height="46"
                                             Fill="#D8E2F1"
                                             VerticalAlignment="Center"/>

                                    <TextBlock x:Name="txtProfileAvatar"
                                               Text="KL"
                                               FontFamily="Inter"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#211B70"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <Ellipse Width="46"
                                             Height="46"
                                             VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="imgProfileAvatar" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>

                                <!-- USER INFO -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">

                                    <TextBlock x:Name="txtProfileFullName"
                                               Text="Nguyễn Kim Loan"
                                               FontFamily="Suez One"
                                               FontSize="19"
                                               Foreground="#0F172A"/>

                                    <Border Background="#E7F8EF"
                                            CornerRadius="12"
                                            Padding="9,4"
                                            HorizontalAlignment="Left"
                                            Margin="0,5,0,0">

                                        <TextBlock Text="Người hướng dẫn đã xác minh"
                                                   FontFamily="Inter"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#16A34A"/>
                                    </Border>
                                </StackPanel>

                                <!-- EDIT PROFILE -->
                                <Button Grid.Column="2"
                                        Content="Chỉnh sửa hồ sơ"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="125"
                                        Height="38"
                                        VerticalAlignment="Center"
                                        Click="BtnEditProfile_Click"/>
                            </Grid>
                        </Border>

                        <!-- PERSONAL UTILITIES TITLE -->
                        <TextBlock Text="Tiện ích cá nhân"
                                   FontFamily="Suez One"
                                   FontSize="19"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,12"/>

                        <!-- TWO UTILITY CARDS -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT CARD -->
                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,12,0">

                                <StackPanel>

                                    <!-- MENTOR REGISTRATION -->
                                    <Button Style="{StaticResource UtilityItemButtonStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>

                                            <svgc:SvgViewbox
                                                Source="/Assets/Icons/circle-check.svg"
                                                Width="15" Height="15"
                                                VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="Đăng ký làm người hướng dẫn"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="›"
                                                       FontSize="20"
                                                       Foreground="#211B70"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- MANAGE MENTORS -->
                                    <Button Style="{StaticResource UtilityItemButtonStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>

                                            <svgc:SvgViewbox
                                                Source="/Assets/Icons/users.svg"
                                                Width="15" Height="15"
                                                VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="Quản lý người được hướng dẫn"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="›"
                                                       FontSize="20"
                                                       Foreground="#211B70"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- APPLICATIONS -->
                                    <Button Style="{StaticResource UtilityItemButtonStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>

                                            <svgc:SvgViewbox
                                                Source="/Assets/Icons/file-text.svg"
                                                Width="15" Height="15"
                                                VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="Đơn ứng tuyển của tôi"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="›"
                                                       FontSize="20"
                                                       Foreground="#211B70"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT CARD -->
                            <Border Grid.Column="1"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,0">

                                <StackPanel>

                                    <!-- SAVED ITEMS -->
                                    <Button Style="{StaticResource UtilityItemButtonStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>

                                            <svgc:SvgViewbox
                                                Source="/Assets/Icons/bookmark.svg"
                                                Width="15" Height="15"
                                                VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="Đã lưu"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="›"
                                                       FontSize="20"
                                                       Foreground="#211B70"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- ACCOUNT SETTINGS -->
                                    <Button Style="{StaticResource UtilityItemButtonStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>

                                            <svgc:SvgViewbox
                                                Source="/Assets/Icons/Cài đặt.svg"
                                                Width="15" Height="15"
                                                VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="Cài đặt tài khoản"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="›"
                                                       FontSize="20"
                                                       Foreground="#211B70"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <!-- SUPPORT -->
                                    <Button Style="{StaticResource UtilityItemButtonStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>

                                            <svgc:SvgViewbox
                                                Source="/Assets/Icons/circle-help.svg"
                                                Width="15" Height="15"
                                                VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="Trung tâm hỗ trợ"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="›"
                                                       FontSize="20"
                                                       Foreground="#211B70"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </UserControl>
