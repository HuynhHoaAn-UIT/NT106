                                            HorizontalContentAlignment="Left"
                                            Padding="0"
                                            Cursor="Hand">

                                        <TextBlock Text="Cài đặt tài khoản →"
                                                   FontFamily="Inter"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#211B70"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
