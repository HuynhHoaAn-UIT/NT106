                                    <TextBlock Text="Học bổng MEXT Nhật Bản"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,10"/>

                                    <TextBlock
