<UserControl x:Class="GlobalSuccess.Desktop.Views.Account.AccountSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             MinWidth="1000"
             MinHeight="700">

    <UserControl.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="BrandPrimary" Color="#211B70"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F7FC"/>
        <SolidColorBrush x:Key="MainText" Color="#0F172A"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

        <!-- SIDEBAR BUTTON -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#F1F0FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INPUT -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#211B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LABEL -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- OUTLINE BUTTON -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#211B70"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="9,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#211B70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#342D8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TAB -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- ROOT -->
    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">

                    <Image Source="/Assets/Icons/logo.png"
                           Width="40"
                           Height="40"
                           Stretch="Uniform"/>

                    <TextBlock Text="GLOBAL&#10;SUCCESS"
                               FontFamily="Inter"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#211B70"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               LineHeight="16"/>
                </StackPanel>

                <!-- MAIN NAVIGATION -->
                <StackPanel Grid.Row="1"
                            Margin="10,0,10,10">

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/compass.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Khám phá học bổng"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/Cộng đồng.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Cộng đồng"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/Tin nhắn.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Tin nhắn"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ACCOUNT ACTIVE -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Background="#EEEDFA"
                            Foreground="#211B70">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/Tài khoản.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Tài khoản"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- PERSONAL SPACE -->
                <StackPanel Grid.Row="2"
                            Margin="10,0,10,10">

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,0,0,18"/>

                    <TextBlock Text="KHÔNG GIAN CỦA BẠN"
                               FontFamily="Inter"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="10,0,0,8"/>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/bookmark.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Mục đã lưu"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- BOTTOM NAVIGATION -->
                <StackPanel Grid.Row="4"
                            Margin="10,0,10,10">

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/Đăng xuất.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Đăng xuất"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/Cài đặt.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Cài đặt tài khoản"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/circle-help.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Trung tâm hỗ trợ"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,8,0,12"/>

                    <!-- USER PROFILE -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="34"
                                 Height="34"
                                 Fill="#D8E2F1"
                                 VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="0"
                                   Text="KL"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#211B70"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="Nguyễn Kim Loan"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="Người hướng dẫn"
                                       FontFamily="Inter"
                                       FontSize="9"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="⌄"
                                   FontSize="15"
                                   Foreground="#211B70"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- MAIN AREA -->
        <!-- ================================================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">

                <Grid Margin="28,0,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <!-- BREADCRUMB -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="GLOBAL SUCCESS"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#94A3B8"/>

                        <TextBlock Text="  /  "
                                   FontSize="11"
                                   Foreground="#CBD5E1"/>

                        <TextBlock Text="Tài khoản"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                    </StackPanel>

                    <!-- SEARCH -->
                    <Border Grid.Column="1"
                            Width="260"
                            Height="38"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Center">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <svgc:SvgViewbox
                                Grid.Column="0"
                                Source="/Assets/Icons/Biểu tượng tìm kiếm.svg"
                                Width="15" Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     Height="34"
                                     Padding="8,0"
                                     FontFamily="Inter"
                                     FontSize="10"
                                     Foreground="#64748B"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     Text="Tìm học bổng, bài viết..."/>
                        </Grid>
                    </Border>

                    <!-- NOTIFICATION -->
                    <svgc:SvgViewbox
                        Grid.Column="2"
                        Source="/Assets/Icons/Thông báo.svg"
                        Width="20" Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <!-- AVATAR PLACEHOLDER -->
                    <Ellipse Grid.Column="3"
                             Width="30"
                             Height="30"
                             Fill="#D8E2F1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ================================================= -->
            <!-- ACCOUNT SETTINGS CONTENT -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="32,20,32,22">

                    <!-- PAGE HEADER -->
                    <StackPanel Margin="0,0,0,14">

                        <TextBlock Text="Tùy chọn tài khoản"
                                   FontFamily="Suez One"
                                   FontSize="25"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Quản lý thông tin hồ sơ, hiển thị và tài khoản"
                                   FontFamily="Inter"
                                   FontSize="10"
                                   Foreground="#94A3B8"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- TABS -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12">

                        <Button Content="Thông tin cá nhân"
                                Style="{StaticResource TabButtonStyle}"
                                Background="#211B70"
                                Foreground="White"
                                Margin="0,0,6,0"/>

                        <Button Content="Hiển thị"
                                Style="{StaticResource TabButtonStyle}"
                                Margin="0,0,6,0"/>

                        <Button Content="Tài khoản"
                                Style="{StaticResource TabButtonStyle}"/>
                    </StackPanel>

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,0,0,14"/>

                    <!-- PROFILE FORM CARD -->
                    <Border Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="18">

                        <StackPanel>

                            <!-- CARD TITLE -->
                            <TextBlock Text="Thông tin cá nhân"
                                       FontFamily="Suez One"
                                       FontSize="15"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,12"/>

                            <!-- PROFILE HEADER -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- AVATAR -->
                                <Border Width="38"
                                        Height="38"
                                        CornerRadius="19"
                                        Background="#D8E2F1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="KL"
                                               FontFamily="Inter"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#211B70"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- NAME -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">

                                    <TextBlock Text="Nguyễn Kim Loan"
                                               FontFamily="Inter"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"/>

                                    <TextBlock Text="Daphne"
                                               FontFamily="Inter"
                                               FontSize="9"
                                               Foreground="#64748B"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- CHANGE PHOTO -->
                                <Button Grid.Column="2"
                                        Content="Thay đổi ảnh"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#211B70"
                                        FontFamily="Inter"
                                        FontSize="9"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1"
                                    Background="#E2E8F0"
                                    Margin="0,0,0,12"/>

                            <!-- NAME AND NICKNAME -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Họ và tên"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="Nguyễn Kim Loan"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Biệt danh"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="Daphne"/>
                                </StackPanel>
                            </Grid>

                            <!-- EMAIL -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Gmail"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}"
                                         Text="loannguyen.work@gmail.com"/>
                            </StackPanel>

                            <!-- PHONE -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="🇺🇸"
                                           FontSize="16"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,8"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Số điện thoại"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="123-456-7890"/>
                                </StackPanel>
                            </Grid>

                            <!-- COUNTRY AND GENDER -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Quốc gia"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="Việt Nam"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Giới tính"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Style="{StaticResource FormTextBoxStyle}"
                                             Text="Nữ"/>
                                </StackPanel>
                            </Grid>

                            <!-- ADDRESS -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Địa chỉ"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}"
                                         Text="45 Phạm Ngũ Lão"/>
                            </StackPanel>

                            <!-- UNIVERSITY -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Trường"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource FormTextBoxStyle}"
                                         Text="Đại học Công nghệ Thông tin - ĐHQG HCM"/>
                            </StackPanel>

                            <!-- FOOTER -->
                            <Border Height="1"
                                    Background="#E2E8F0"
                                    Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Kiểm tra thông tin trước khi lưu thay đổi."
                                           FontFamily="Inter"
                                           FontSize="9"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="1"
                                        Content="Lưu"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="78"
                                        Height="36"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
