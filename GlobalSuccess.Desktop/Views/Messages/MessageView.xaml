<UserControl x:Class="GlobalSuccess.Desktop.Views.Messages.MessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             MinWidth="1000"
             MinHeight="700">

    <UserControl.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="BrandPrimary" Color="#211B70"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F7FC"/>
        <SolidColorBrush x:Key="MainText" Color="#0F172A"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ChatBubbleMine" Color="#EEEDFA"/>
        <SolidColorBrush x:Key="ChatBubbleOther" Color="#FFFFFF"/>

        <!-- SIDEBAR BUTTON -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#F1F0FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#211B70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#342D8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#17124F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SEARCH TEXTBOX -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- CHAT ACTION BUTTON -->
        <Style x:Key="ChatActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#211B70"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder"
                                        Property="Background"
                                        Value="#EEEDFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CHAT MESSAGE TEXT -->
        <Style x:Key="ChatMessageTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

    </UserControl.Resources>

    <!-- ROOT -->
    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- SIDEBAR - SAME AS HOME / COMMUNITY -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">

                    <Image Source="/Assets/Icons/logo.png"
                           Width="40"
                           Height="40"
                           Stretch="Uniform"/>

                    <TextBlock Text="GLOBAL&#10;SUCCESS"
                               FontFamily="Inter"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#211B70"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               LineHeight="16"/>
                </StackPanel>

                <!-- MAIN NAVIGATION -->
                <StackPanel Grid.Row="1"
                            Margin="10,0,10,10">

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/compass.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Khám phá học bổng"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/community.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Cộng đồng"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- MESSAGES ACTIVE -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Background="#EEEDFA"
                            Foreground="#211B70">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/message.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Tin nhắn"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/account.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Tài khoản"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- PERSONAL SPACE -->
                <StackPanel Grid.Row="2"
                            Margin="10,0,10,10">

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,0,0,18"/>

                    <TextBlock Text="KHÔNG GIAN CỦA BẠN"
                               FontFamily="Inter"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="10,0,0,8"/>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/bookmark.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Mục đã lưu"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- BOTTOM NAVIGATION -->
                <StackPanel Grid.Row="4"
                            Margin="10,0,10,10">

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/log_out.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Đăng xuất"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/setting.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Cài đặt tài khoản"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ"
                                       FontSize="17"
                                       Foreground="#64748B"
                                       Width="17"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="Trung tâm hỗ trợ"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,8,0,12"/>

                    <!-- USER PROFILE -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="34"
                                 Height="34"
                                 Fill="#D8E2F1"
                                 VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="0"
                                   Text="KL"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#211B70"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="Nguyễn Kim Loan"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="Bạn"
                                       FontFamily="Inter"
                                       FontSize="9"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="⌄"
                                   FontSize="15"
                                   Foreground="#211B70"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- MAIN AREA -->
        <!-- ================================================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">

                <Grid Margin="28,0,28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <!-- BREADCRUMB -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="GLOBAL SUCCESS"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#94A3B8"/>

                        <TextBlock Text="  /  "
                                   FontSize="11"
                                   Foreground="#CBD5E1"/>

                        <TextBlock Text="Tin nhắn"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                    </StackPanel>

                    <!-- TOP SEARCH -->
                    <Border Grid.Column="1"
                            Width="260"
                            Height="38"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Center">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <svgc:SvgViewbox
                                Grid.Column="0"
                                Source="/Assets/Icons/find.svg"
                                Width="15" Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="Tìm học bổng, bài viết..."/>
                        </Grid>
                    </Border>

                    <!-- NOTIFICATION -->
                    <svgc:SvgViewbox
                        Grid.Column="2"
                        Source="/Assets/Icons/bell.svg"
                        Width="20" Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <!-- AVATAR -->
                    <Ellipse Grid.Column="3"
                             Width="30" Height="30"
                             Fill="#D8E2F1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ================================================= -->
            <!-- MESSAGE CONTENT -->
            <!-- ================================================= -->

            <Grid Grid.Row="1"
                  Margin="24,16,24,20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- PAGE HEADER -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,18">

                    <TextBlock Text="Tin nhắn"
                               FontFamily="Suez One"
                               FontSize="28"
                               Foreground="#0F172A"/>

                    <TextBlock Text="DAPHNE AND PEERS"
                               FontFamily="Inter"
                               FontSize="10"
                               Foreground="#94A3B8"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- MESSAGING PANEL -->
                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        ClipToBounds="True">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="325"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================================= -->
                        <!-- LEFT: CONVERSATION LIST -->
                        <!-- ================================= -->

                        <Grid Grid.Column="0"
                              Background="White">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="42"/>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- CONVERSATION HEADER -->
                            <Grid Grid.Row="0"
                                  Margin="16,0,14,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Trò chuyện"
                                           FontFamily="Suez One"
                                           FontSize="16"
                                           Foreground="#0F172A"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="1"
                                        Content="✎"
                                        Style="{StaticResource ChatActionButtonStyle}"
                                        FontSize="17"/>
                            </Grid>

                            <!-- CONVERSATION SEARCH -->
                            <Border Grid.Row="1"
                                    Margin="14,0,14,6"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="⌕"
                                               FontSize="18"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource SearchTextBoxStyle}"
                                             Text="Tìm kiếm"/>
                                </Grid>
                            </Border>

                            <!-- QUICK CONTACTS -->
                            <ScrollViewer Grid.Row="2"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">

                                <StackPanel Orientation="Horizontal"
                                            Margin="12,5,8,5">

                                    <StackPanel Margin="5,0">
                                        <Ellipse Width="34"
                                                 Height="34"
                                                 Fill="#E7F0F7"/>
                                        <TextBlock Text="◉"
                                                   Foreground="#4C8DBA"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,-27,0,0"
                                                   IsHitTestVisible="False"/>
                                    </StackPanel>

                                    <Ellipse Width="34"
                                             Height="34"
                                             Fill="#E8DDCB"
                                             Margin="5,0"/>

                                    <Ellipse Width="34"
                                             Height="34"
                                             Fill="#E6F2EC"
                                             Margin="5,0"/>

                                    <Ellipse Width="34"
                                             Height="34"
                                             Fill="#DCEBE2"
                                             Margin="5,0"/>

                                    <Ellipse Width="34"
                                             Height="34"
                                             Fill="#D8E2F1"
                                             Margin="5,0"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- CONTACT LIST -->
                            <ScrollViewer Grid.Row="3"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">

                                <StackPanel>

                                    <!-- CONTACT 1 -->
                                    <Border Background="#F8F8FC"
                                            Padding="12,10">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="34"
                                                     Height="34"
                                                     Fill="#E3EAF3"/>

                                            <TextBlock Grid.Column="0"
                                                       Text="T"
                                                       FontFamily="Inter"
                                                       FontWeight="Bold"
                                                       Foreground="#211B70"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Tâm Anh"
                                                           FontFamily="Inter"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A"/>
                                                <TextBlock Text="Bạn: Chúc em thành công."
                                                           FontFamily="Inter"
                                                           FontSize="9"
                                                           Foreground="#94A3B8"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="10:58"
                                                       FontFamily="Inter"
                                                       FontSize="9"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- CONTACT 2 -->
                                    <Border Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="34"
                                                     Height="34"
                                                     Fill="#E8DDCB"/>

                                            <TextBlock Grid.Column="0"
                                                       Text="D"
                                                       FontWeight="Bold"
                                                       Foreground="#8A6D4F"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="DABIS"
                                                           FontFamily="Inter"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A"/>
                                                <TextBlock Text="DABIS đã gửi một tệp đính kèm."
                                                           FontFamily="Inter"
                                                           FontSize="9"
                                                           Foreground="#94A3B8"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="10:28"
                                                       FontFamily="Inter"
                                                       FontSize="9"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- CONTACT 3 -->
                                    <Border Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="34"
                                                     Height="34"
                                                     Fill="#E6F2EC"/>

                                            <TextBlock Grid.Column="0"
                                                       Text="K"
                                                       FontWeight="Bold"
                                                       Foreground="#3A956C"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Kim Ngân"
                                                           FontFamily="Inter"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A"/>
                                                <TextBlock Text="2 tin nhắn mới"
                                                           FontFamily="Inter"
                                                           FontSize="9"
                                                           Foreground="#94A3B8"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="09:14"
                                                       FontFamily="Inter"
                                                       FontSize="9"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- CONTACT 4 -->
                                    <Border Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="34"
                                                     Height="34"
                                                     Fill="#DDF2E8"/>

                                            <TextBlock Grid.Column="0"
                                                       Text="L"
                                                       FontWeight="Bold"
                                                       Foreground="#20996B"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Lên"
                                                           FontFamily="Inter"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A"/>
                                                <TextBlock Text="526 tin nhắn mới"
                                                           FontFamily="Inter"
                                                           FontSize="9"
                                                           Foreground="#94A3B8"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="7:15"
                                                       FontFamily="Inter"
                                                       FontSize="9"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- CONTACT 5 -->
                                    <Border Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="34"
                                                     Height="34"
                                                     Fill="#D8E2F1"/>

                                            <TextBlock Grid.Column="0"
                                                       Text="T"
                                                       FontWeight="Bold"
                                                       Foreground="#211B70"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="Thu Trâm"
                                                           FontFamily="Inter"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A"/>
                                                <TextBlock Text="Đã bày tỏ cảm xúc về tin nhắn..."
                                                           FontFamily="Inter"
                                                           FontSize="9"
                                                           Foreground="#94A3B8"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="7:15"
                                                       FontFamily="Inter"
                                                       FontSize="9"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- CONTACT 6 -->
                                    <Border Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
