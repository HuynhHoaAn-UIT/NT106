<UserControl x:Class="GlobalSuccess.Desktop.Views.Community.CreatePostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             MinWidth="1000"
             MinHeight="700">

    <UserControl.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="BrandPrimary" Color="#211B70"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F7FC"/>
        <SolidColorBrush x:Key="MainText" Color="#0F172A"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

        <!-- SIDEBAR BUTTON -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#F1F0FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#211B70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#342D8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#17124F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- OUTLINE BUTTON -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#211B70"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TAG BUTTON -->
        <Style x:Key="TagButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Background" Value="#EEEDFA"/>
            <Setter Property="Foreground" Value="#211B70"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SEARCH TEXTBOX -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <!-- ROOT LAYOUT -->
    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================= -->
        <!-- SIDEBAR - KEEP CONSISTENT WITH HOME AND COMMUNITY -->
        <!-- ================================================= -->

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">

                    <Image Source="/Assets/Icons/logo.png"
                           Width="40"
                           Height="40"
                           Stretch="Uniform"/>

                    <TextBlock Text="GLOBAL&#10;SUCCESS"
                               FontFamily="Inter"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#211B70"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               LineHeight="16"/>
                </StackPanel>

                <!-- MAIN NAVIGATION -->
                <StackPanel Grid.Row="1"
                            Margin="10,0,10,10">

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/compass.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Khám phá học bổng"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- COMMUNITY ACTIVE -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Background="#EEEDFA"
                            Foreground="#211B70">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/community.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Cộng đồng"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/message.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Tin nhắn"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/account.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Tài khoản"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- PERSONAL SPACE -->
                <StackPanel Grid.Row="2"
                            Margin="10,0,10,10">

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,0,0,18"/>

                    <TextBlock Text="KHÔNG GIAN CỦA BẠN"
                               FontFamily="Inter"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="10,0,0,8"/>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/bookmark.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Mục đã lưu"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- BOTTOM NAVIGATION -->
                <StackPanel Grid.Row="4"
                            Margin="10,0,10,10">

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/log_out.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Đăng xuất"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/setting.svg"
                                Width="17" Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Cài đặt tài khoản"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ"
                                       FontSize="17"
                                       Foreground="#64748B"
                                       Width="17"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="Trung tâm hỗ trợ"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,8,0,12"/>

                    <!-- USER PROFILE -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="34"
                                 Height="34"
                                 Fill="#D8E2F1"
                                 VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="0"
                                   Text="KL"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#211B70"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="Nguyễn Kim Loan"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="Bạn"
                                       FontFamily="Inter"
                                       FontSize="9"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="⌄"
                                   FontSize="15"
                                   Foreground="#211B70"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- MAIN AREA -->
        <!-- ================================================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- TOPBAR - KEEP CONSISTENT WITH HOME AND COMMUNITY -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">

                <Grid Margin="28,0,28,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <!-- BREADCRUMB -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="GLOBAL SUCCESS"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#94A3B8"/>

                        <TextBlock Text="  /  "
                                   FontSize="11"
                                   Foreground="#CBD5E1"/>

                        <TextBlock Text="Cộng đồng"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#64748B"/>

                        <TextBlock Text="  /  "
                                   FontSize="11"
                                   Foreground="#CBD5E1"/>

                        <TextBlock Text="Bài viết mới"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#211B70"/>
                    </StackPanel>

                    <!-- SEARCH -->
                    <Border Grid.Column="1"
                            Width="260"
                            Height="38"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Center">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <svgc:SvgViewbox
                                Grid.Column="0"
                                Source="/Assets/Icons/find.svg"
                                Width="15" Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="Tìm học bổng, bài viết..."/>
                        </Grid>
                    </Border>

                    <!-- NOTIFICATION -->
                    <svgc:SvgViewbox
                        Grid.Column="2"
                        Source="/Assets/Icons/bell.svg"
                        Width="20" Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <!-- AVATAR -->
                    <Ellipse Grid.Column="3"
                             Width="30"
                             Height="30"
                             Fill="#D8E2F1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ================================================= -->
            <!-- CREATE POST CONTENT -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="32,22,32,28">

                    <!-- PAGE HEADER -->
                    <Grid Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Bài viết mới"
                                       FontFamily="Suez One"
                                       FontSize="28"
                                       Foreground="#0F172A"/>

                            <TextBlock
                                Text="Chia sẻ câu chuyện của bạn với cộng đồng GLOBAL SUCCESS"
                                FontFamily="Inter"
                                FontSize="12"
                                Foreground="#64748B"
                                Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Quay lại cộng đồng"
                                Style="{StaticResource OutlineButtonStyle}"
                                Width="145"
                                Height="38"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- CONTENT COLUMNS -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: POST COMPOSER -->
                        <Border Grid.Column="0"
                                Background="White"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,14,0">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- AUTHOR -->
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="36"
                                             Height="36"
                                             Fill="#D8E2F1"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="0"
                                               Text="D"
                                               FontFamily="Inter"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#211B70"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">

                                        <TextBlock Text="Daphne"
                                                   FontFamily="Inter"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"/>

                                        <TextBlock Text="Đăng lên Cộng đồng"
                                                   FontFamily="Inter"
                                                   FontSize="10"
                                                   Foreground="#94A3B8"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="Mọi người"
                                            Style="{StaticResource TagButtonStyle}"
                                            Height="25"/>
                                </Grid>

                                <Border Grid.Row="0"
                                        VerticalAlignment="Bottom"
                                        Height="1"
                                        Background="#E2E8F0"
                                        Margin="0,0,0,-12"/>

                                <!-- POST OPTIONS -->
                                <WrapPanel Grid.Row="1"
                                           Margin="0,10,0,12">

                                    <Button Content="Mọi người"
                                            Style="{StaticResource TagButtonStyle}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="Vị trí"
                                            Style="{StaticResource TagButtonStyle}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="Cảm xúc/hoạt động"
                                            Style="{StaticResource TagButtonStyle}"/>
                                </WrapPanel>

                                <!-- POST TEXT -->
                                <TextBox x:Name="PostContentTextBox"
                                         Grid.Row="2"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontFamily="Inter"
                                         FontSize="13"
                                         Foreground="#334155"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         Padding="0,8,0,8"
                                         MinHeight="280"
                                         Text="Bạn đang nghĩ gì?"/>

                                <!-- ADD IMAGE -->
                                <Border Grid.Row="3"
                                        BorderBrush="#DCE3F0"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="14"
                                        Margin="0,10,0,10">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="▧"
                                                   FontFamily="Segoe UI Symbol"
                                                   FontSize="24"
                                                   Foreground="#211B70"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0">

                                            <TextBlock Text="Thêm ảnh vào bài viết"
                                                       FontFamily="Inter"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>

                                            <TextBlock Text="Chọn ảnh để chia sẻ với mọi người"
                                                       FontFamily="Inter"
                                                       FontSize="10"
                                                       Foreground="#94A3B8"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Chọn ảnh"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#211B70"
                                                FontFamily="Inter"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- FOOTER -->
                                <Grid Grid.Row="4">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#E2E8F0"/>

                                    <Grid Grid.Row="1"
                                          Margin="0,10,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Bài viết sẽ hiển thị với mọi người."
                                                   FontFamily="Inter"
                                                   FontSize="10"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="1"
                                                Content="Hủy"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Width="82"
                                                Height="38"
                                                Margin="0,0,10,0"/>

                                        <Button Grid.Column="2"
                                                Content="Đăng"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Width="100"
                                                Height="38"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- RIGHT: GUIDANCE -->
                        <StackPanel Grid.Column="1">

                            <!-- SHARE GUIDANCE -->
                            <Border Background="#EEEDFA"
                                    BorderBrush="#E5E2F7"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18"
                                    Margin="0,0,0,14">

                                <StackPanel>

                                    <TextBlock Text="Chia sẻ để cùng tiến xa"
                                               FontFamily="Suez One"
                                               FontSize="17"
                                               Foreground="#0F172A"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <TextBlock Text="✎"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="25"
                                               Foreground="#211B70"
                                               Margin="0,0,0,8"/>

                                    <TextBlock
                                        Text="Kinh nghiệm ứng tuyển, chuẩn bị hồ sơ hay hành trình nhận học bổng của bạn có thể giúp ích cho cộng đồng."
                                        FontFamily="Inter"
                                        FontSize="11"
                                        Foreground="#64748B"
                                        TextWrapping="Wrap"
                                        LineHeight="18"/>
                                </StackPanel>
                            </Border>

                            <!-- BEFORE POSTING -->
                            <Border Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="18">

                                <StackPanel>

                                    <TextBlock Text="Trước khi đăng"
                                               FontFamily="Suez One"
                                               FontSize="17"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,12"/>

                                    <TextBlock
                                        Text="Kiểm tra nội dung và thông tin cá nhân trước khi chia sẻ công khai."
                                        FontFamily="Inter"
                                        FontSize="11"
                                        Foreground="#64748B"
                                        TextWrapping="Wrap"
                                        LineHeight="18"
                                        Margin="0,0,0,12"/>

                                    <TextBlock
                                        Text="Giữ sự chân thật và tôn trọng trong mỗi bài viết."
                                        FontFamily="Inter"
                                        FontSize="11"
                                        Foreground="#64748B"
                                        TextWrapping="Wrap"
                                        LineHeight="18"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
