<UserControl x:Class="GlobalSuccess.Desktop.Views.Community.CommunityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             MinWidth="1000"
             MinHeight="700">

    <UserControl.Resources>

        <!-- COLORS -->
        <SolidColorBrush x:Key="BrandPrimary" Color="#211B70"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F7FC"/>
        <SolidColorBrush x:Key="MainText" Color="#0F172A"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

        <!-- SIDEBAR BUTTON -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder"
                                        Property="Background"
                                        Value="#F1F0FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#211B70"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#342D8A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#17124F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SEARCH BOX -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- POST ACTION BUTTON -->
        <Style x:Key="PostActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#211B70"/>
            <Setter Property="FontFamily" Value="Inter"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F0FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================ -->
        <!-- SIDEBAR - SAME AS HOME -->
        <!-- ============================================ -->

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">

                    <Image Source="/Assets/Icons/logo.png"
                           Width="40"
                           Height="40"
                           Stretch="Uniform"/>

                    <TextBlock Text="GLOBAL&#10;SUCCESS"
                               FontFamily="Inter"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#211B70"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               LineHeight="16"/>
                </StackPanel>

                <!-- MAIN NAVIGATION -->
                <StackPanel Grid.Row="1"
                            Margin="10,0,10,10">

                    <!-- EXPLORE -->
                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/compass.svg"
                                Width="17"
                                Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Khám phá học bổng"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- COMMUNITY - ACTIVE -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Background="#EEEDFA"
                            Foreground="#211B70">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/community.svg"
                                Width="17"
                                Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Cộng đồng"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- MESSAGES -->
                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/message.svg"
                                Width="17"
                                Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Tin nhắn"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- ACCOUNT -->
                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/account.svg"
                                Width="17"
                                Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Tài khoản"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- PERSONAL SPACE -->
                <StackPanel Grid.Row="2"
                            Margin="10,0,10,10">

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,0,0,18"/>

                    <TextBlock Text="KHÔNG GIAN CỦA BẠN"
                               FontFamily="Inter"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="10,0,0,8"/>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/bookmark.svg"
                                Width="17"
                                Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Mục đã lưu"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- BOTTOM NAVIGATION -->
                <StackPanel Grid.Row="4"
                            Margin="10,0,10,10">

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/log_out.svg"
                                Width="17"
                                Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Đăng xuất"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <svgc:SvgViewbox
                                Source="/Assets/Icons/setting.svg"
                                Width="17"
                                Height="17"
                                Margin="0,0,12,0"/>
                            <TextBlock Text="Cài đặt tài khoản"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ"
                                       FontSize="17"
                                       Foreground="#64748B"
                                       Width="17"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="Trung tâm hỗ trợ"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,8,0,12"/>

                    <!-- USER PROFILE -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="34"
                                 Height="34"
                                 Fill="#D8E2F1"
                                 VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="0"
                                   Text="KL"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#211B70"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <TextBlock Text="Nguyễn Kim Loan"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="Bạn"
                                       FontFamily="Inter"
                                       FontSize="9"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="⌄"
                                   FontSize="15"
                                   Foreground="#211B70"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================ -->
        <!-- MAIN CONTENT -->
        <!-- ============================================ -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR - SAME AS HOME -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">

                <Grid Margin="28,0,28,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <!-- BREADCRUMB -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="GLOBAL SUCCESS"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#94A3B8"/>

                        <TextBlock Text="  /  "
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#CBD5E1"/>

                        <TextBlock Text="Cộng đồng"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                    </StackPanel>

                    <!-- TOP SEARCH -->
                    <Border Grid.Column="1"
                            Width="260"
                            Height="38"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            VerticalAlignment="Center">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <svgc:SvgViewbox
                                Grid.Column="0"
                                Source="/Assets/Icons/find.svg"
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Text="Tìm học bổng, bài viết..."/>
                        </Grid>
                    </Border>

                    <!-- NOTIFICATION -->
                    <svgc:SvgViewbox
                        Grid.Column="2"
                        Source="/Assets/Icons/bell.svg"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                    <!-- AVATAR -->
                    <Ellipse Grid.Column="3"
                             Width="30"
                             Height="30"
                             Fill="#D8E2F1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ======================================== -->
            <!-- COMMUNITY CONTENT -->
            <!-- ======================================== -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="32,22,32,28">

                    <!-- PAGE HEADER -->
                    <Grid Margin="0,0,0,16">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cộng đồng"
                                       FontFamily="Suez One"
                                       FontSize="28"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="Chia sẻ kinh nghiệm và kết nối với người hướng dẫn"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Viết bài chia sẻ"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="145"
                                Height="40"
                                VerticalAlignment="Top"/>
                    </Grid>

                    <!-- FEED AND RIGHT PANEL -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.65*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ================================= -->
                        <!-- LEFT: COMMUNITY FEED -->
                        <!-- ================================= -->

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,12,0">

                            <!-- SEARCH POST -->
                            <Border Height="42"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Margin="0,0,0,16">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <svgc:SvgViewbox
                                        Grid.Column="0"
                                        Source="/Assets/Icons/find.svg"
                                        Width="15"
                                        Height="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource SearchTextBoxStyle}"
                                             Text="Tìm kiếm"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- ================================= -->
                            <!-- POST 1 -->
                            <!-- ================================= -->

                            <Border Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="22"
                                    Margin="0,0,0,16">

                                <StackPanel>

                                    <!-- POST HEADER -->
                                    <Grid Margin="0,0,0,14">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="25"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- AVATAR -->
                                        <Ellipse Width="36"
                                                 Height="36"
                                                 Fill="#D8E2F1"/>

                                        <TextBlock Grid.Column="0"
                                                   Text="HA"
                                                   FontFamily="Inter"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#211B70"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <!-- USER INFO -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0">

                                            <TextBlock Text="Huỳnh Hòa An"
                                                       FontFamily="Inter"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>

                                            <TextBlock Text="2 giờ trước"
                                                       FontFamily="Inter"
                                                       FontSize="10"
                                                       Foreground="#94A3B8"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- MORE -->
                                        <Button Grid.Column="2"
                                                Content="•••"
                                                Style="{StaticResource PostActionButtonStyle}"
                                                FontSize="13"
                                                VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- POST CONTENT -->
                                    <TextBlock
                                        Text="Một số kinh nghiệm mình rút ra sau khi ứng tuyển học bổng thành công: chuẩn bị hồ sơ sớm, làm nổi bật các hoạt động ngoại khóa và thể hiện rõ mục tiêu của bản thân; đừng quên chuẩn bị thư bày tỏ nguyện vọng sớm nhất có thể nhé."
                                        FontFamily="Inter"
                                        FontSize="11"
                                        Foreground="#334155"
                                        TextWrapping="Wrap"
                                        LineHeight="19"
                                        Margin="0,0,0,12"/>

                                    <TextBlock
                                        Text="Bởi vì đây chính là 'vũ khí' tốt thường giúp bạn định vị bản thân giữa hàng ngàn ứng viên nặng ký. Đừng chỉ liệt kê thành tích một cách khô khan. Hãy biến nó thành một câu chuyện truyền cảm hứng, kết nối chặt chẽ giữa quá khứ, hiện tại và tương lai. Hãy trả lời thật thuyết phục câu hỏi: 'Tại sao soạn học này, ngôi trường này lại là mảnh ghép hoàn hảo cho hành trình tiếp theo của bạn?'"
                                        FontFamily="Inter"
                                        FontSize="11"
                                        Foreground="#334155"
                                        TextWrapping="Wrap"
                                        LineHeight="19"
                                        Margin="0,0,0,12"/>

                                    <TextBlock
                                        Text="Bên cạnh đó, việc chọn người viết thư giới thiệu (thư giới thiệu) cũng vô cùng quan trọng. Hãy ưu tiên những thầy cô hoặc cấp trên thực sự hiểu rõ năng lực và thái độ làm việc của bạn, thay vì những người chỉ biết về bạn nhưng chỉ chia sẻ vài ba lời. Một bức thư cá nhân hóa, chi tiết và chân thật luôn có sức nặng hơn một mẫu biểu mẫu chung chung."
                                        FontFamily="Inter"
                                        FontSize="11"
                                        Foreground="#334155"
                                        TextWrapping="Wrap"
                                        LineHeight="19"
                                        Margin="0,0,0,14"/>

                                    <!-- POST FOOTER LINK -->
                                    <Border Height="1"
                                            Background="#E2E8F0"
                                            Margin="0,0,0,10"/>

                                    <Button Content="Kết nối với người hướng dẫn →"
                                            Style="{StaticResource PostActionButtonStyle}"
                                            HorizontalAlignment="Left"
                                            FontWeight="SemiBold"
                                            Margin="0,0,0,8"/>

                                    <!-- REACTIONS -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="♡   188"
                                                Style="{StaticResource PostActionButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Foreground="#EF4444"/>

                                        <Button Grid.Column="1"
                                                Content="◯   342"
                                                Style="{StaticResource PostActionButtonStyle}"/>

                                        <Button Grid.Column="2"
                                                Content="➤   718"
                                                Style="{StaticResource PostActionButtonStyle}"/>

                                        <Button Grid.Column="3"
                                                Content="♧"
                                                Style="{StaticResource PostActionButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ================================= -->
                            <!-- POST 2 -->
                            <!-- ================================= -->

                            <Border Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="22"
                                    Margin="0,0,0,16">

                                <StackPanel>

                                    <!-- POST HEADER -->
                                    <Grid Margin="0,0,0,14">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="25"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="36"
                                                 Height="36"
                                                 Fill="#E2E8F0"/>

                                        <TextBlock Grid.Column="0"
                                                   Text="B"
                                                   FontFamily="Inter"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#211B70"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0">

                                            <TextBlock Text="Bảo"
                                                       FontFamily="Inter"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>

                                            <TextBlock Text="2 giờ trước"
                                                       FontFamily="Inter"
                                                       FontSize="10"
                                                       Foreground="#94A3B8"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="•••"
                                                Style="{StaticResource PostActionButtonStyle}"
                                                FontSize="13"
                                                VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- POST CONTENT -->
                                    <TextBlock
                                        Text="Một số kinh nghiệm mình rút ra sau khi ứng tuyển học bổng thành công: chuẩn bị hồ sơ sớm, làm nổi bật các hoạt động ngoại khóa và thể hiện rõ mục tiêu của bản thân; đừng quên chuẩn bị thư bày tỏ nguyện vọng sớm nhất có thể nhé."
                                        FontFamily="Inter"
                                        FontSize="11"
                                        Foreground="#334155"
                                        TextWrapping="Wrap"
                                        LineHeight="19"
                                        Margin="0,0,0,12"/>

                                    <TextBlock
                                        Text="Bởi vì đây chính là 'vũ khí' tốt thường giúp bạn định vị bản thân giữa hàng ngàn ứng viên nặng ký. Đừng chỉ liệt kê thành tích một cách khô khan. Hãy biến nó thành một câu chuyện truyền cảm hứng, kết nối chặt chẽ giữa quá khứ, hiện tại và tương lai. Hãy trả lời thật thuyết phục câu hỏi: 'Tại sao soạn học này, ngôi trường này lại là mảnh ghép hoàn hảo cho hành trình tiếp theo của bạn?'"
                                        FontFamily="Inter"
                                        FontSize="11"
                                        Foreground="#334155"
                                        TextWrapping="Wrap"
                                        LineHeight="19"
                                        Margin="0,0,0,12"/>

                                    <TextBlock
                                        Text="Bên cạnh đó, việc chọn người viết thư giới thiệu cũng vô cùng quan trọng. Hãy ưu tiên những thầy cô hoặc cấp trên thực sự hiểu rõ năng lực và thái độ làm việc của bạn, thay vì những người chỉ biết về bạn nhưng chỉ chia sẻ vài ba lời. Một bức thư cá nhân hóa, chi tiết và chân thật luôn có sức nặng hơn một mẫu biểu chung chung."
