<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================== -->
    <!-- 1. BRAND COLORS                       -->
    <!-- ===================================== -->

    <Color x:Key="ColorPrimary">#0F0954</Color>

    <!-- ===================================== -->
    <!-- 2. BACKGROUND COLORS                  -->
    <!-- ===================================== -->

    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorBackground">#F8FAFC</Color>
    <Color x:Key="ColorSecondaryBackground">#E0ECFF</Color>


    <!-- ===================================== -->
    <!-- 3. TEXT COLORS                        -->
    <!-- ===================================== -->

    <Color x:Key="ColorTextPrimary">#0F172A</Color>
    <Color x:Key="ColorTextHint">#64748B</Color>


    <!-- ===================================== -->
    <!-- 4. BORDER COLORS                      -->
    <!-- ===================================== -->

    <Color x:Key="ColorBorder">#E2E8F0</Color>


    <!-- ===================================== -->
    <!-- 5. STATUS COLORS                      -->
    <!-- ===================================== -->

    <Color x:Key="ColorApproved">#15803D</Color>
    <Color x:Key="ColorPending">#B45309</Color>
    <Color x:Key="ColorRejected">#B91C1C</Color>


    <!-- ===================================== -->
    <!-- 6. SOLID COLOR BRUSHES                -->
    <!-- ===================================== -->

    <SolidColorBrush x:Key="BrushPrimary"
                     Color="{StaticResource ColorPrimary}"/>

    <SolidColorBrush x:Key="BrushSurface"
                     Color="{StaticResource ColorSurface}"/>

    <SolidColorBrush x:Key="BrushBackground"
                     Color="{StaticResource ColorBackground}"/>

    <SolidColorBrush x:Key="BrushSecondaryBackground"
                     Color="{StaticResource ColorSecondaryBackground}"/>

    <SolidColorBrush x:Key="BrushTextPrimary"
                     Color="{StaticResource ColorTextPrimary}"/>

    <SolidColorBrush x:Key="BrushTextHint"
                     Color="{StaticResource ColorTextHint}"/>

    <SolidColorBrush x:Key="BrushBorder"
                     Color="{StaticResource ColorBorder}"/>

    <SolidColorBrush x:Key="BrushApproved"
                     Color="{StaticResource ColorApproved}"/>

    <SolidColorBrush x:Key="BrushPending"
                     Color="{StaticResource ColorPending}"/>

    <SolidColorBrush x:Key="BrushRejected"
                     Color="{StaticResource ColorRejected}"/>

</ResourceDictionary>
