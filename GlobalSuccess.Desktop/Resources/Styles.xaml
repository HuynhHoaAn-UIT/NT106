<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Field Label -->
    <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Helper Text -->
    <Style x:Key="HelperTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- Error Message -->
    <Style x:Key="ErrorMessageStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Page Title -->
    <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Section Title -->
    <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Card Container -->
    <Style x:Key="CardContainerStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Divider -->
    <Style x:Key="DividerStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="#E2E8F0"/>
        <Setter Property="Margin" Value="0,12"/>
    </Style>

</ResourceDictionary>
